{
  "apiVersion": 3,
  "name": "al-base/content-listing",
  "version": "1.0.0",
  "title": "Content Listing",
  "category": "theme",
  "icon": "screenoptions",
  "description": "Reusable advanced queries with independent layouts and cards.",
  "textdomain": "al-base",
  "usesContext": ["postId", "postType"],
  "attributes": {
    "listingId": {"type": "string", "default": ""},
    "source": {"type": "string", "default": "posts"},
    "postType": {"type": "string", "default": "post"},
    "taxonomy": {"type": "string", "default": "category"},
    "terms": {"type": "array", "default": []},
    "hideEmpty": {"type": "boolean", "default": true},
    "parent": {"type": "number", "default": 0},
    "author": {"type": "number", "default": 0},
    "include": {"type": "array", "default": []},
    "exclude": {"type": "array", "default": []},
    "relationField": {"type": "string", "default": ""},
    "sortField": {"type": "string", "default": ""},
    "perPage": {"type": "number", "default": 6},
    "offset": {"type": "number", "default": 0},
    "orderBy": {"type": "string", "default": "date"},
    "order": {"type": "string", "default": "DESC"},
    "pagination": {"type": "string", "default": "none"},
    "layout": {"type": "string", "default": "grid"},
    "columns": {"type": "number", "default": 3},
    "tabletColumns": {"type": "number", "default": 2},
    "mobileColumns": {"type": "number", "default": 1},
    "gap": {"type": "string", "default": "m"},
    "cardVariant": {"type": "string", "default": "default"},
    "elements": {"type": "array", "default": ["image", "category", "title", "excerpt", "date", "button"]},
    "fields": {"type": "array", "default": []},
    "badgeField": {"type": "string", "default": ""},
    "headingLevel": {"type": "number", "default": 2}
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "color": {"background": true, "text": true},
    "spacing": {"padding": true, "margin": true},
    "anchor": true
  }
}
