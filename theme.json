{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {"contentSize": "740px", "wideSize": "1240px"},
    "color": {
      "defaultPalette": false,
      "palette": [
        {"slug": "primary", "name": "Primary", "color": "#174a43"},
        {"slug": "secondary", "name": "Secondary", "color": "#27364a"},
        {"slug": "accent", "name": "Accent", "color": "#a3451b"},
        {"slug": "background", "name": "Background", "color": "#ffffff"},
        {"slug": "surface", "name": "Surface", "color": "#f2f5f4"},
        {"slug": "text", "name": "Text", "color": "#162320"},
        {"slug": "muted", "name": "Muted", "color": "#53645f"},
        {"slug": "border", "name": "Border", "color": "#c4ceca"}
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [{"slug": "body", "name": "System Sans", "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"}],
      "fontSizes": [
        {"slug": "small", "name": "Small", "size": "0.875rem", "fluid": false},
        {"slug": "body", "name": "Body", "size": "1rem", "fluid": false},
        {"slug": "h6", "name": "H6", "size": "1.125rem"},
        {"slug": "h5", "name": "H5", "size": "1.25rem"},
        {"slug": "h4", "name": "H4", "size": "1.5rem"},
        {"slug": "h3", "name": "H3", "size": "1.875rem"},
        {"slug": "h2", "name": "H2", "size": "2.5rem"},
        {"slug": "h1", "name": "H1", "size": "3.25rem"},
        {"slug": "display", "name": "Display", "size": "4.5rem", "fluid": {"min": "2.75rem", "max": "4.5rem"}}
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw", "vh"],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {"slug": "xs", "name": "XS", "size": "0.5rem"},
        {"slug": "s", "name": "S", "size": "1rem"},
        {"slug": "m", "name": "M", "size": "1.5rem"},
        {"slug": "l", "name": "L", "size": "clamp(2rem, 4vw, 3rem)"},
        {"slug": "xl", "name": "XL", "size": "clamp(3rem, 6vw, 5rem)"},
        {"slug": "2xl", "name": "2XL", "size": "clamp(4rem, 8vw, 7rem)"}
      ]
    },
    "shadow": {"defaultPresets": false, "presets": [{"slug": "soft", "name": "Soft", "shadow": "0 8px 32px rgba(22,35,32,0.08)"}]},
    "custom": {
      "layout": {"gutter": "clamp(1rem, 3vw, 1.5rem)"},
      "radius": {"small": "0.375rem", "medium": "0.75rem", "large": "1.5rem"},
      "breakpoint": {"tablet": "600px", "desktop": "1000px"},
      "borderWidth": "1px",
      "imageRatio": "3/2"
    }
  },
  "styles": {
    "color": {"background": "var:preset|color|background", "text": "var:preset|color|text"},
    "typography": {"fontFamily": "var:preset|font-family|body", "fontSize": "var:preset|font-size|body", "lineHeight": "1.65"},
    "spacing": {"blockGap": "var:preset|spacing|m"},
    "elements": {
      "heading": {"typography": {"lineHeight": "1.15", "fontWeight": "700"}},
      "h1": {"typography": {"fontSize": "var:preset|font-size|h-1"}},
      "h2": {"typography": {"fontSize": "var:preset|font-size|h-2"}},
      "h3": {"typography": {"fontSize": "var:preset|font-size|h-3"}},
      "h4": {"typography": {"fontSize": "var:preset|font-size|h-4"}},
      "h5": {"typography": {"fontSize": "var:preset|font-size|h-5"}},
      "h6": {"typography": {"fontSize": "var:preset|font-size|h-6"}},
      "link": {"color": {"text": "var:preset|color|primary"}},
      "button": {"color": {"background": "var:preset|color|primary", "text": "var:preset|color|background"}, "border": {"radius": "var:custom|radius|small"}, "spacing": {"padding": {"top": "0.75rem", "bottom": "0.75rem", "left": "1.25rem", "right": "1.25rem"}}}
    }
  }
}
